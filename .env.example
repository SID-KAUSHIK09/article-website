# Copy to .env.local and fill in from Supabase: Project Settings > API.
# The anon key is safe in the browser; row level security (see
# supabase/migrations) is what stops it being used to change data.
# Never put the service_role key in a VITE_ variable: it would ship to every visitor.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
